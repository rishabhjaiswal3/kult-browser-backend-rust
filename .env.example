# MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=kult_browser
MONGO_CONN_RETRIES=5

# Collection names (all optional, defaults shown)
GAMES_COLL=kultbrowser_games
CONTENT_COLL=kultbrowser_content_configs
CAMPAIGNS_COLL=kultbrowser_campaigns
CHATBOT_COLL=kultbrowser_chatbot_knowledge
PLAYERS_COLL=store_players
GLOBAL_LEADERBOARD_COLL=global_leaderboards
GAME_LEADERBOARD_CONFIG_COLL=store_games_leaderboards

# Logging
LOG_LEVEL=info              # trace|debug|info|warn|error
LOG_FORMAT=pretty           # pretty|json (json for production)
LOG_FILE_INFO=false         # Include file:line in output
LOG_TARGET=true             # Include module path in output

# Server
APP_HOST=0.0.0.0
APP_PORT=4000

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRY_HOURS=24

# Valkey (Redis-compatible)
VALKEY_URL=redis://127.0.0.1:6379

# DigitalOcean Spaces (Moments Uploads)
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_REGION=sfo3
MOMENTS_DO_SPACES_BUCKET=your-bucket
MOMENTS_DO_SPACES_PRESIGNED_EXPIRATION=300
MOMENTS_UPLOAD_PATH=moments
MOMENTS_DOWNLOAD_TMP_DIR=/tmp/moments

# 0G Storage
ZG_BINARY_PATH=./src/external/0g/storage/0g-storage-client
ZG_RPC_URL=https://evmrpc.0g.ai/
ZG_PRIVATE_KEY=your-private-key-here
ZG_INDEXER_URL=https://indexer-storage-turbo.0g.ai
ZG_RPC_TIMEOUT=800s
ZG_RPC_RETRY_COUNT=5
ZG_RPC_RETRY_INTERVAL=3s
